{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node hosting/build-static.mjs",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/console",
      "destination": "/console.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/api/:route(session|acceptance|evaluation|cases)",
      "destination": "/api/public-demo?route=:route"
    },
    {
      "source": "/api/cases/:id",
      "destination": "/api/public-demo?route=cases/:id"
    },
    {
      "source": "/api/cases/:id/trace.svg",
      "destination": "/api/public-demo?route=cases/:id/trace.svg"
    },
    {
      "source": "/api/cases/:id/diagram.svg",
      "destination": "/api/public-demo?route=cases/:id/diagram.svg"
    },
    {
      "source": "/api/cases/:id/selfgraph.json",
      "destination": "/api/public-demo?route=cases/:id/selfgraph.json"
    },
    {
      "source": "/workspace",
      "destination": "/console.html"
    },
    {
      "source": "/org-api/:route(session|cases|case-page)",
      "destination": "/api/org-workspace?route=org-api/:route"
    },
    {
      "source": "/org-api/auth/status",
      "destination": "/api/org-workspace?route=org-api/auth/status"
    },
    {
      "source": "/org-api/handoffs/claim",
      "destination": "/api/org-workspace?route=org-api/handoffs/claim"
    },
    {
      "source": "/org-api/handoffs/:id/:action(context|finish)",
      "destination": "/api/org-workspace?route=org-api/handoffs/:id/:action"
    },
    {
      "source": "/org-api/import/report",
      "destination": "/api/org-workspace?route=org-api/import/report"
    },
    {
      "source": "/org-api/cases/:id",
      "destination": "/api/org-workspace?route=org-api/cases/:id"
    },
    {
      "source": "/org-api/cases/:id/:view(diagram\\.svg|trace\\.svg|reviews)",
      "destination": "/api/org-workspace?route=org-api/cases/:id/:view"
    },
    {
      "source": "/hooks/:provider(hackerone|bugcrowd)",
      "destination": "/api/org-workspace?route=hooks/:provider"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'"
        }
      ]
    }
  ]
}
